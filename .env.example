# SEC requires a descriptive User-Agent with a contact email: "AppName your-name@your-domain.com"
SEC_USER_AGENT="secqa-portfolio-project your-email@example.com"
DATABASE_URL=postgresql://secqa:secqa@localhost:5432/secqa
FISCAL_YEARS=2023,2024,2025
EMBED_MODEL=ibm-granite/granite-embedding-small-english-r2
# LLM: gemini | ollama | none  (none = extractive answers, no API key needed)
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=granite3.3:8b
